# Copy to .env and fill in. NEVER commit the real .env.

# Backend bridge URL
VITE_BACKEND=http://localhost:8787

# Google Maps key for the embedded map cards (Maps Embed API).
# Without it, the "📍 Open in Google Maps" links still work.
VITE_MAPS_KEY=

# Set true only after enabling "Maps Embed API" on the key's Cloud project.
VITE_MAPS_EMBED=false
