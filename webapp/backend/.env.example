# Copy to .env and fill in. NEVER commit the real .env.

# Anthropic API key — powers the real agent. Leave empty to run the scripted
# demo fallback (UI still works, shop data still live if the Maps key is set).
ANTHROPIC_API_KEY=

# Claude model + effort for the agent loop.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=low

# Google Maps key with the Places API enabled — live ratings/opening hours.
GOOGLE_MAPS_API_KEY=

# PORT=8787
# DEMO_MODE=1            # force the scripted fallback even with a key
# DIST_WINDOW_MS=7200000 # fair-distribution rolling window (default 2h)
